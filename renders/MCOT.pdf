				<strong>Du <span id="dat_deb_et1"></span> au <span id="dat_fin_et1"></span></strong>
			</div>
			<div class="text-center">Titre, motivation et ancrage au thème</div>
			<div class="text-center">MCOT</div>
			<br />
			
			

			<div class="text-center">
				<span class="badge badge-pill badgeTIPE">ÉTAPE 2</span>
			</div>
			<div class="text-center">
			
			<strong>Du <span id="dat_deb_et2"></span> au <span id="dat_fin_et2"></span></strong>

	
				
			</div>
			<div class="text-center">Présentation - DOT</div>
			<br />
			
			
						<div class="text-center">
				<span class="badge badge-pill badgeTIPE">ÉTAPE 3</span>
			</div>
			<div class="text-center">
			
				
			<strong>Du <span id="dat_deb_et3"></span> au <span id="dat_fin_et3"></span></strong>

	
				
			</div>
			<div class="text-center">Validation par le professeur encadrant</div>
			<br />
			
		</div>


		
		<div id="blocAuthentification" class="col-lg-3 text-center">
			<h6 id="headerAuthentification" class="mb-4 text-uppercase">
				Accès à mon dossier
			</h6>
			<form id="authentificationCandidatForm" action="authentifierCandidat" method="post" autocomplete="off">
				<input id="uriDemandee" name="uriDemandee" type="hidden" value="/mcot"/>
				<input id="tut_cod" name="tut_cod" type="hidden" value=""/>
				<div class="form-group text-left">
					<label for="can_cod">
						Numéro d'inscription
					</label>
					<input id="can_cod" name="can_cod" class="form-control" maxLength="6" type="text" value=""/>
					
				</div>
				<div class="form-group text-left mb-5">
					<label for="can_mot_pas">
						Mot de passe
					</label>
					<input id="can_mot_pas" name="can_mot_pas" class="form-control" type="password" value=""/>
					
				</div>
				<button type="submit" 
						class="btn btn-primary d-block my-6 mx-auto unSeulClic">
					Connexion
				</button>
				<a href="afficherRecuperationCodes?uriDemandee=/mcot"
					class="d-block mt-5">
					Codes perdus?
				</a>
			</form>
		</div>

		
	</div>
</div>



        
        

