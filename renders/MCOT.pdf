<div id="containerAuthentification" class="container text-center">
	<div id="emplacementAlerteConfigurable">
		<div id="messageCandidatRedirige" class="scei-bloc-info d-none">
			Pour poursuivre, veuillez vous authentifier.
		</div>
	</div>
	<div class="row justify-content-center">
		
		<div id="blocEtapes" class="col-lg-4  text-center">
			<h6 id="headerEtapes" class="text-uppercase">
				Les différents jalons de l'épreuve TIPE
			</h6>
			<br />
			<div id="spinner" class="spinner-border" role="status">
